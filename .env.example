# ─────────────────────────────────────────────────────────────
# moodytiger — environment variables
# Copy to .env.local (local) or set in Vercel → Project → Settings → Environment Variables.
# The app runs fully in demo mode with NONE of these set.
# ─────────────────────────────────────────────────────────────

# --- Supabase (optional; demo data is used when absent) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Owner allow-list for dashboard login (comma-separated)
NEXT_PUBLIC_ADMIN_EMAILS=owner@moodytiger.com
# Public store URL
NEXT_PUBLIC_ORDER_URL=https://moodytiger.com/

# --- Influencer discovery (optional; server-side only) ---
SERPAPI_KEY=
APOLLO_API_KEY=

# --- Shopify OAuth (Integrations → Connect with the store) ---
# Create an app in your Shopify Partner dashboard.
# Set the redirect/callback URL to:  https://YOUR-DEPLOYMENT/api/shopify/callback
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Scopes you request (comma-separated)
SHOPIFY_SCOPES=read_products,read_orders

# --- Instagram (Meta) OAuth (Integrations → Instagram) ---
# Create an app at developers.facebook.com with Instagram API enabled.
# Set the OAuth redirect URI to:  https://YOUR-DEPLOYMENT/api/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Posting to IG also requires these scopes AND Meta app review to go live.
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish
