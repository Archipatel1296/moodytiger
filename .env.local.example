# ─────────────────────────────────────────────────────────────
# moodytiger Marketing Engine — Environment variables
# Copy this file to ".env.local" and fill in your Supabase values.
# (The app runs on seeded demo data even if you leave these blank.)
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API → anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Emails allowed into the owner dashboard (/admin), comma-separated
NEXT_PUBLIC_ADMIN_EMAILS=owner@moodytiger.com

# Where the "Shop" button links
NEXT_PUBLIC_ORDER_URL=https://moodytiger.com/

# ── Live creator discovery (optional) ────────────────────────
# Server-side only — do NOT prefix with NEXT_PUBLIC.
# Without it, "Run discovery agent" shows sample creators.
# Get a key at https://serpapi.com/
SERPAPI_KEY=
